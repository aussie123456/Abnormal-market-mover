{"text":"<style>\n  .am { font-family: var(--font-anthropic-sans); font-variant-numeric: tabular-nums; display: grid; gap: var(--cds-gap-lg); }\n  .am h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }\n  .am h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .am p { margin: 0; }\n  .am-head { display: grid; gap: var(--cds-gap-sm); }\n  .am-title-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--cds-gap-sm); }\n  .am-controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-sm); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .am-controls select { font: inherit; color: var(--color-fg); background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: 0.25rem 0.5rem; }\n  .am-controls label { display: inline-flex; align-items: center; gap: 0.3rem; cursor: pointer; }\n  .am-takeaway { font-size: var(--cds-font-size-body); max-width: 70ch; }\n  .am-takeaway b { font-weight: 600; }\n  .am-markets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); gap: var(--cds-gap-sm); }\n  .am-mkt { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-sm) var(--cds-pad-md); display: grid; gap: 0.15rem; font-size: var(--cds-font-size-caption); min-height: 4.6rem; }\n  .am-mkt-name { font-weight: 600; font-size: var(--cds-font-size-body); display: flex; justify-content: space-between; align-items: center; gap: 0.4rem; }\n  .am-state { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--cds-font-size-caption); font-weight: 400; color: var(--color-fg-muted); }\n  .am-state::before { content: \"\"; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--cds-chart-muted); }\n  .am-state.is-open::before { background: var(--color-ok); }\n  .am-mkt-row { display: flex; justify-content: space-between; gap: 0.5rem; color: var(--color-fg-muted); }\n  .am-mkt-row span:last-child { color: var(--color-fg); }\n  .am-section { display: grid; gap: var(--cds-gap-sm); }\n  .am-section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--cds-gap-sm); }\n  .am-rule { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; }\n  .am-count { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .am-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--cds-gap-md); }\n  .am-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); min-width: 0; }\n  .am-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--cds-gap-sm); }\n  .am-sym { font-weight: 700; font-size: var(--cds-font-size-heading); }\n  .am-name { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); overflow-wrap: anywhere; }\n  .am-chip { display: inline-block; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); border: 1px solid var(--color-border-line); border-radius: 999px; padding: 0 0.5rem; white-space: nowrap; }\n  .am-big { font-family: var(--font-anthropic-serif); font-size: calc(var(--cds-font-size-title) * 1.35); line-height: 1.1; }\n  .am-big-row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--cds-gap-sm); }\n  .am-z { font-size: var(--cds-font-size-body); font-weight: 600; border-radius: var(--cds-radius); padding: 0.1rem 0.5rem; border: 1px solid var(--color-border-line); white-space: nowrap; }\n  .am-up { color: var(--color-ok); }\n  .am-down { color: var(--color-bad); }\n  .am-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.2rem 0.8rem; font-size: var(--cds-font-size-caption); }\n  .am-stats div { display: flex; justify-content: space-between; gap: 0.5rem; }\n  .am-stats span:first-child { color: var(--color-fg-muted); }\n  .am-spark { width: 100%; height: 2.6rem; display: block; }\n  .am-cat { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .am-note { font-size: var(--cds-font-size-caption); line-height: 1.4; }\n  .am-tablebox { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: auto; max-height: 34rem; min-height: 3.5rem; }\n  .am table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); }\n  .am th, .am td { text-align: right; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; vertical-align: top; }\n  .am th:first-child, .am td:first-child { text-align: left; }\n  .am th { position: sticky; top: 0; background: var(--color-panel); color: var(--color-fg-muted); font-weight: 500; cursor: pointer; user-select: none; z-index: 1; }\n  .am th[aria-sort=\"descending\"]::after { content: \" ▾\"; }\n  .am th[aria-sort=\"ascending\"]::after { content: \" ▴\"; }\n  .am tbody tr { cursor: pointer; }\n  .am tbody tr:hover td { background: color-mix(in srgb, var(--color-fg) 4%, transparent); }\n  .am tbody tr.is-selected td { background: color-mix(in srgb, var(--color-fg) 7%, transparent); }\n  .am td.am-namecell { white-space: normal; min-width: 11rem; }\n  .am td.am-namecell small { display: block; color: var(--color-fg-muted); }\n  .am td.am-notecell { white-space: normal; min-width: 16rem; max-width: 28rem; text-align: left; line-height: 1.35; }\n  .am th.am-notecell { text-align: left; }\n  .am .am-empty { padding: var(--cds-pad-md); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); text-align: center; }\n  .am-failed { display: flex; align-items: center; justify-content: center; gap: 0.4rem; min-height: 3.5rem; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .am-failed::before { content: \"\"; width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--color-bad); }\n  .am-detail { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); font-size: var(--cds-font-size-caption); }\n  .am-detail-head { display: flex; justify-content: space-between; gap: var(--cds-gap-sm); flex-wrap: wrap; align-items: baseline; }\n  .am-detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: 0.3rem 1rem; }\n  .am-detail-grid div { display: flex; justify-content: space-between; gap: 0.5rem; border-bottom: 1px solid var(--color-border-line); padding-bottom: 0.2rem; }\n  .am-detail-grid span:first-child { color: var(--color-fg-muted); }\n  .am-detail ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.25rem; }\n  .am-detail a { color: inherit; }\n  .am-detail button { font: inherit; background: none; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); color: var(--color-fg-muted); padding: 0.1rem 0.5rem; cursor: pointer; }\n  .am-method { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); max-width: 80ch; display: grid; gap: 0.4rem; }\n  .am-method b { color: var(--color-fg); font-weight: 600; }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n  @media (max-width: 700px) { .am .am-hide-narrow { display: none; } }\n</style>\n\n<div class=\"am\">\n  <header class=\"am-head\" id=\"top\">\n    <div class=\"am-title-row\">\n      <h1>Abnormal Movers</h1>\n      <div class=\"am-controls\">\n        <select id=\"am-market\" aria-label=\"Market\">\n          <option value=\"all\">All markets</option>\n          <option value=\"S&amp;P 500\">S&amp;P 500</option>\n          <option value=\"NASDAQ\">NASDAQ</option>\n          <option value=\"ASX\">ASX</option>\n          <option value=\"Nikkei 225\">Nikkei 225</option>\n          <option value=\"KOSPI\">KOSPI</option>\n        </select>\n        <label><input type=\"checkbox\" id=\"am-show-excluded\"> Show pre-revenue names</label>\n      </div>\n    </div>\n    <p class=\"am-takeaway\" id=\"am-takeaway\">\n      <span data-source=\"counts\" data-field=\"as_of\" class=\"dash-skeleton\">—</span> ·\n      <b data-source=\"counts\" data-field=\"screened\">—</b> names screened ·\n      <b data-source=\"counts\" data-field=\"tier1\">—</b> large caps moving abnormally ·\n      <b data-source=\"counts\" data-field=\"tier2\">—</b> moved 30%+ on the week ·\n      <b data-source=\"counts\" data-field=\"tier3\">—</b> moved 10%+ today ·\n      <span data-source=\"counts\" data-field=\"excluded\">—</span> pre-revenue names set aside.\n    </p>\n    <div class=\"am-markets\" id=\"am-markets\" data-source=\"markets\"></div>\n  </header>\n\n  <section class=\"am-section\" id=\"tier1\">\n    <div class=\"am-section-head\">\n      <h2>Tier 1 · Large caps moving abnormally</h2>\n      <span class=\"am-count\" id=\"am-tier1-count\"></span>\n    </div>\n    <p class=\"am-rule\">Market cap of US$10bn or more and today's move at least 3 standard deviations from the name's own 200-session daily-return distribution. These are the ones where the market's model was wrong.</p>\n    <div class=\"am-cards\" id=\"am-cards\" data-source=\"movers sparks\"></div>\n  </section>\n\n  <section class=\"am-section\" id=\"tier2\">\n    <div class=\"am-section-head\">\n      <h2>Tier 2 · Moved 30% or more over five sessions</h2>\n      <span class=\"am-count\" id=\"am-tier2-count\"></span>\n    </div>\n    <p class=\"am-rule\">Any size in the universe. Revenue-generating operators only. Click a row for headlines and the balance sheet.</p>\n    <div class=\"am-tablebox\" id=\"am-box-tier2\"></div>\n    <div id=\"am-detail-tier2\"></div>\n  </section>\n\n  <section class=\"am-section\" id=\"tier3\">\n    <div class=\"am-section-head\">\n      <h2>Tier 3 · Moved 10% or more today</h2>\n      <span class=\"am-count\" id=\"am-tier3-count\"></span>\n    </div>\n    <p class=\"am-rule\">Today's move versus the prior close, live while a market is open. Names already in tier 1 or tier 2 are listed again here so each list is complete on its own.</p>\n    <div class=\"am-tablebox\" id=\"am-box-tier3\"></div>\n    <div id=\"am-detail-tier3\"></div>\n  </section>\n\n  <section class=\"am-section\" id=\"peers\">\n    <div class=\"am-section-head\">\n      <h2>Peer strip · Crypto miners and AI infrastructure</h2>\n      <span class=\"am-count\" id=\"am-peers-count\"></span>\n    </div>\n    <p class=\"am-rule\">IREN and its comparables, shown every run whatever they did. They are structurally volatile, so they never compete with the main screen.</p>\n    <div class=\"am-tablebox\" id=\"am-box-peers\"></div>\n    <div id=\"am-detail-peers\"></div>\n  </section>\n\n  <section class=\"am-section\" id=\"excluded\" hidden>\n    <div class=\"am-section-head\">\n      <h2>Set aside · Pre-revenue names that tripped a screen</h2>\n      <span class=\"am-count\" id=\"am-excluded-count\"></span>\n    </div>\n    <p class=\"am-rule\">Trailing revenue below US$50m. Explorers, clinical-stage biotech and pre-commercial names, where a big move is a punt repricing rather than a model breaking.</p>\n    <div class=\"am-tablebox\" id=\"am-box-excluded\"></div>\n    <div id=\"am-detail-excluded\"></div>\n  </section>\n\n  <section class=\"am-section\" id=\"method\">\n    <h2>How the screen works</h2>\n    <div class=\"am-method\">\n      <p><b>Universe.</b> S&amp;P 500 members, every NASDAQ-listed company with a market cap of US$1bn or more, the top of the ASX by market cap (about the ASX 300), Nikkei 225 members and the largest KOSPI names (about the KOSPI 200). Roughly 2,000 companies.</p>\n      <p><b>Stage filter.</b> A name needs trailing twelve-month revenue of at least US$50m to appear in the tiers. Below that it is set aside and counted, not hidden.</p>\n      <p><b>Abnormality.</b> z is today's log return minus the name's mean daily log return over the prior 200 sessions, divided by the standard deviation of those returns. Price versus the 200-day moving average is shown for context only.</p>\n      <p><b>Balance sheet.</b> Net debt is total debt less cash. Net debt to EBITDA uses trailing EBITDA; \"net cash\" means cash exceeds debt. Debt to EV is total debt as a share of enterprise value. Facility-level detail (undrawn lines, converts, maturities) needs filings and is not on this page.</p>\n      <p><b>Refresh.</b> Hourly on weekdays by a cloud routine. Prices and fundamentals are from Yahoo Finance; headlines are from Google News. Market caps and balance sheets are converted to US dollars at the run's spot rates. Notes are written by the routine from the headlines and are a prompt to look further, not a conclusion.</p>\n    </div>\n  </section>\n</div>\n\n<script>\n(function () {\n  const $ = (s, el) => (el || document).querySelector(s);\n  const enc = (v) => String(v).replace(/%/g, '%25').replace(/&/g, '%26').replace(/=/g, '%3D');\n  const num = (v) => (v === null || v === undefined || v === '' ? null : (isNaN(Number(v)) ? null : Number(v)));\n  const arr = (v) => (Array.isArray(v) ? v : (typeof v === 'string' && v.trim().startsWith('[') ? JSON.parse(v) : []));\n  const syd = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });\n  const sydShort = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', weekday: 'short', hour: 'numeric', minute: '2-digit' });\n  const fmt = {\n    pct: (v) => { v = num(v); return v === null ? '—' : (v > 0 ? '+' : '') + v.toFixed(1) + '%'; },\n    z: (v) => { v = num(v); return v === null ? '—' : (v > 0 ? '+' : '') + v.toFixed(1) + 'σ'; },\n    cap: (v) => { v = num(v); if (!v) return '—'; const a = Math.abs(v); const s = a >= 1e12 ? (v / 1e12).toFixed(2) + 'tn' : a >= 1e9 ? (v / 1e9).toFixed(1) + 'bn' : (v / 1e6).toFixed(0) + 'm'; return 'US$' + s; },\n    money: (v) => { v = num(v); if (v === null) return '—'; const a = Math.abs(v); const s = a >= 1e9 ? (a / 1e9).toFixed(1) + 'bn' : (a / 1e6).toFixed(0) + 'm'; return (v < 0 ? '-' : '') + 'US$' + s; },\n    x: (v) => { v = num(v); return v === null ? '—' : v.toFixed(1) + 'x'; },\n    price: (v, ccy) => { v = num(v); if (v === null) return '—'; return (ccy ? ccy + ' ' : '') + (v >= 1000 ? v.toLocaleString('en', { maximumFractionDigits: 0 }) : v.toFixed(2)); },\n    when: (iso) => { if (!iso) return '—'; const d = new Date(iso); return isNaN(d) ? '—' : syd.format(d) + ' AEDT'; },\n    whenShort: (iso) => { if (!iso) return '—'; const d = new Date(iso); return isNaN(d) ? '—' : sydShort.format(d); },\n    ndE: (r) => { const nd = num(r.net_debt_usd), e = num(r.ebitda_usd); if (nd === null) return '—'; if (nd < 0) return 'net cash'; if (!e || e <= 0) return fmt.money(nd) + ' (EBITDA ≤ 0)'; return fmt.x(nd / e); },\n    state: (s) => ({ REGULAR: 'Open', PRE: 'Pre-market', POST: 'After hours', PREPRE: 'Closed', POSTPOST: 'Closed', CLOSED: 'Closed' }[s] || (s ? s : 'Closed')),\n  };\n  const cls = (v) => { v = num(v); return v === null ? '' : v > 0 ? 'am-up' : v < 0 ? 'am-down' : ''; };\n  const norm = (r) => Object.assign({}, r, { tiers: arr(r.tiers), headlines: arr(r.headlines), peer: r.peer === true || r.peer === 'true', excluded: r.excluded && r.excluded !== 'null' ? r.excluded : null });\n\n  dash.calc('counts', {\n    inputs: ['movers', 'markets'],\n    title: 'Screen counts',\n    description: 'How many names were screened and how many fell into each tier, from the movers and markets files.',\n    fn: (movers, markets) => {\n      const tiers = (r) => Array.isArray(r.tiers) ? r.tiers : JSON.parse(r.tiers || '[]');\n      const main = movers.filter((r) => !r.peer && !r.excluded);\n      const run = markets.map((m) => m.run_at).sort().pop();\n      return {\n        screened: markets.reduce((a, m) => a + Number(m.quoted || 0), 0),\n        universe: markets.reduce((a, m) => a + Number(m.universe || 0), 0),\n        tier1: main.filter((r) => tiers(r).includes(1)).length,\n        tier2: main.filter((r) => tiers(r).includes(2)).length,\n        tier3: main.filter((r) => tiers(r).includes(3)).length,\n        excluded: movers.filter((r) => r.excluded).length,\n        peers: movers.filter((r) => r.peer).length,\n        run_at: run || null,\n        as_of: run ? 'As of ' + new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }).format(new Date(run)) + ' AEDT' : '',\n      };\n    },\n  });\n\n  const state = { sort: { tier2: ['wk_pct', 'abs'], tier3: ['day_pct', 'abs'], peers: ['day_pct', 'abs'], excluded: ['day_pct', 'abs'] }, selected: {}, showExcluded: false };\n  const marketSel = $('#am-market');\n  marketSel.addEventListener('change', () => dash.setParams({ market: marketSel.value }));\n  $('#am-show-excluded').addEventListener('change', (e) => { state.showExcluded = e.target.checked; draw(); });\n\n  const COLS = [\n    { f: 'symbol', label: 'Name', cell: (r) => { const td = document.createElement('td'); td.className = 'am-namecell'; const b = document.createElement('b'); b.textContent = r.symbol; td.appendChild(b); const s = document.createElement('small'); s.textContent = r.name || ''; td.appendChild(s); return td; } },\n    { f: 'market', label: 'Market', hide: true, cell: (r) => cellText(r.market) },\n    { f: 'price', label: 'Price', hide: true, cell: (r) => cellText(fmt.price(r.price, r.currency)) },\n    { f: 'day_pct', label: 'Today', cell: (r) => cellText(fmt.pct(r.day_pct), cls(r.day_pct)) },\n    { f: 'wk_pct', label: '5 sessions', cell: (r) => cellText(fmt.pct(r.wk_pct), cls(r.wk_pct)) },\n    { f: 'z', label: 'z', cell: (r) => cellText(fmt.z(r.z)) },\n    { f: 'ma200_dev', label: 'vs 200-DMA', hide: true, cell: (r) => cellText(fmt.pct(r.ma200_dev)) },\n    { f: 'mcap_usd', label: 'Mkt cap', cell: (r) => cellText(fmt.cap(r.mcap_usd)) },\n    { f: 'nd_ebitda', label: 'Net debt / EBITDA', cell: (r) => cellText(fmt.ndE(r)) },\n    { f: 'debt_ev', label: 'Debt / EV', hide: true, cell: (r) => cellText(num(r.debt_ev) === null ? '—' : num(r.debt_ev).toFixed(0) + '%') },\n    { f: 'catalyst', label: 'Next catalyst', cell: (r) => cellText(r.catalyst || '—') },\n    { f: 'note', label: 'What happened', note: true, cell: (r) => { const td = cellText(r.note || (r.headlines && r.headlines.length ? r.headlines[0].title : '—')); td.className = 'am-notecell'; return td; } },\n  ];\n  function cellText(text, className) { const td = document.createElement('td'); td.textContent = text; if (className) td.className = className; return td; }\n\n  function sortRows(rows, key) {\n    const [f, mode] = key;\n    const val = (r) => (f === 'symbol' || f === 'market' || f === 'catalyst' || f === 'note') ? String(r[f] || '') : num(r[f]);\n    return rows.slice().sort((a, b) => {\n      let x = val(a), y = val(b);\n      if (typeof x === 'string') return x.localeCompare(y);\n      if (x === null) return 1; if (y === null) return -1;\n      if (mode === 'abs') return Math.abs(y) - Math.abs(x);\n      return mode === 'asc' ? x - y : y - x;\n    });\n  }\n\n  function table(id, rows, status) {\n    const box = $('#am-box-' + id);\n    box.replaceChildren();\n    box.classList.toggle('dash-skeleton', status === 'loading');\n    if (status === 'error') { const d = document.createElement('div'); d.className = 'am-failed'; d.textContent = 'Failed to load'; box.appendChild(d); return; }\n    if (status !== 'ok') return;\n    if (!rows.length) { const d = document.createElement('div'); d.className = 'am-empty'; d.textContent = 'Nothing tripped this screen in the selected markets.'; box.appendChild(d); return; }\n    const t = document.createElement('table');\n    t.setAttribute('data-source', 'movers'); t.setAttribute('data-row-key', 'symbol');\n    const thead = document.createElement('thead'); const tr = document.createElement('tr');\n    COLS.forEach((c) => {\n      const th = document.createElement('th'); th.textContent = c.label; th.setAttribute('data-field', c.f);\n      if (c.hide) th.className = 'am-hide-narrow'; if (c.note) th.className = 'am-notecell';\n      const cur = state.sort[id];\n      if (cur[0] === c.f) th.setAttribute('aria-sort', cur[1] === 'asc' ? 'ascending' : 'descending');\n      th.addEventListener('click', () => { const s = state.sort[id]; state.sort[id] = s[0] === c.f ? [c.f, s[1] === 'abs' ? 'desc' : s[1] === 'desc' ? 'asc' : 'abs'] : [c.f, 'abs']; draw(); });\n      tr.appendChild(th);\n    });\n    thead.appendChild(tr); t.appendChild(thead);\n    const tb = document.createElement('tbody');\n    sortRows(rows, state.sort[id]).forEach((r) => {\n      const row = document.createElement('tr');\n      row.setAttribute('data-key', r.symbol);\n      if (state.selected[id] === r.symbol) row.className = 'is-selected';\n      COLS.forEach((c) => { const td = c.cell(r); if (c.hide) td.classList.add('am-hide-narrow'); row.appendChild(td); });\n      row.addEventListener('click', () => { state.selected[id] = state.selected[id] === r.symbol ? null : r.symbol; draw(); });\n      tb.appendChild(row);\n    });\n    t.appendChild(tb); box.appendChild(t);\n  }\n\n  function detail(id, rows) {\n    const host = $('#am-detail-' + id);\n    host.replaceChildren();\n    const sym = state.selected[id];\n    const r = sym && rows.find((x) => x.symbol === sym);\n    if (!r) return;\n    const w = 'symbol=' + enc(r.symbol);\n    const d = document.createElement('div'); d.className = 'am-detail';\n    const head = document.createElement('div'); head.className = 'am-detail-head';\n    const h = document.createElement('div'); const b = document.createElement('b'); b.textContent = r.symbol + ' · ' + (r.name || ''); h.appendChild(b);\n    const sub = document.createElement('span'); sub.className = 'am-name'; sub.textContent = ' ' + [r.market, r.exchange, r.sector, r.industry].filter(Boolean).join(' · '); h.appendChild(sub);\n    head.appendChild(h);\n    const close = document.createElement('button'); close.textContent = 'Close'; close.addEventListener('click', () => { state.selected[id] = null; draw(); }); head.appendChild(close);\n    d.appendChild(head);\n    if (r.summary) { const p = document.createElement('p'); p.textContent = r.summary + (r.summary.length >= 220 ? '…' : ''); d.appendChild(p); }\n    const g = document.createElement('div'); g.className = 'am-detail-grid';\n    const items = [\n      ['Revenue (TTM)', fmt.money(r.revenue_usd), 'revenue_usd'], ['Market cap', fmt.cap(r.mcap_usd), 'mcap_usd'], ['Enterprise value', fmt.cap(r.ev_usd), 'ev_usd'],\n      ['Total debt', fmt.money(r.debt_usd), 'debt_usd'], ['Cash', fmt.money(r.cash_usd), 'cash_usd'], ['Net debt', fmt.money(r.net_debt_usd), 'net_debt_usd'],\n      ['EBITDA (TTM)', fmt.money(r.ebitda_usd), 'ebitda_usd'], ['Net debt / EBITDA', fmt.ndE(r), 'nd_ebitda'], ['Debt / EV', num(r.debt_ev) === null ? '—' : num(r.debt_ev).toFixed(0) + '%', 'debt_ev'],\n      ['200-session σ (daily)', num(r.sigma200) === null ? '—' : num(r.sigma200).toFixed(2) + '%', 'sigma200'], ['vs 200-DMA', fmt.pct(r.ma200_dev), 'ma200_dev'], ['Last quote', fmt.whenShort(r.quote_time) + (r.market_state ? ' · ' + fmt.state(r.market_state) : ''), 'quote_time'],\n    ];\n    items.forEach(([k, v, f]) => { const row = document.createElement('div'); const a = document.createElement('span'); a.textContent = k; const bb = document.createElement('span'); bb.textContent = v; bb.setAttribute('data-source', 'movers'); bb.setAttribute('data-field', f); bb.setAttribute('data-where', w); row.appendChild(a); row.appendChild(bb); g.appendChild(row); });\n    d.appendChild(g);\n    if (r.excluded) { const p = document.createElement('p'); p.textContent = 'Set aside: ' + r.excluded + '.'; d.appendChild(p); }\n    if (r.headlines && r.headlines.length) {\n      const ul = document.createElement('ul');\n      r.headlines.forEach((hl) => { const li = document.createElement('li'); const a = document.createElement('a'); a.href = hl.url || '#'; a.target = '_blank'; a.rel = 'noopener'; a.textContent = hl.title || ''; li.appendChild(a); if (hl.source) { const s = document.createElement('span'); s.className = 'am-name'; s.textContent = ' · ' + hl.source; li.appendChild(s); } ul.appendChild(li); });\n      d.appendChild(ul);\n    } else { const p = document.createElement('p'); p.className = 'am-name'; p.textContent = 'No headlines found in the last three days.'; d.appendChild(p); }\n    host.appendChild(d);\n  }\n\n  function sparkline(svg, pts) {\n    svg.replaceChildren();\n    if (!pts || pts.length < 2) return;\n    const w = Math.max(120, svg.clientWidth || 240), h = 40, pad = 3;\n    svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);\n    const x = d3.scaleLinear([0, pts.length - 1], [pad, w - pad]);\n    const ext = d3.extent(pts, (p) => p.close);\n    const y = d3.scaleLinear(ext[0] === ext[1] ? [ext[0] - 1, ext[1] + 1] : ext, [h - pad, pad]);\n    const line = d3.line().x((p, i) => x(i)).y((p) => y(p.close));\n    const up = pts[pts.length - 1].close >= pts[0].close;\n    const color = up ? 'var(--color-ok)' : 'var(--color-bad)';\n    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n    path.setAttribute('d', line(pts)); path.setAttribute('fill', 'none'); path.setAttribute('stroke', color); path.setAttribute('stroke-width', '2'); path.setAttribute('stroke-linejoin', 'round'); path.setAttribute('stroke-linecap', 'round');\n    svg.appendChild(path);\n    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n    c.setAttribute('cx', x(pts.length - 1)); c.setAttribute('cy', y(pts[pts.length - 1].close)); c.setAttribute('r', '4'); c.setAttribute('fill', color); c.setAttribute('stroke', 'var(--color-panel)'); c.setAttribute('stroke-width', '2');\n    svg.appendChild(c);\n  }\n\n  function cards(rows, sparks, status) {\n    const host = $('#am-cards');\n    host.replaceChildren();\n    host.classList.toggle('dash-skeleton', status === 'loading');\n    if (status === 'error') { const d = document.createElement('div'); d.className = 'am-failed'; d.textContent = 'Failed to load'; host.appendChild(d); return; }\n    if (status !== 'ok') return;\n    if (!rows.length) { const d = document.createElement('div'); d.className = 'am-empty'; d.textContent = 'No large cap is moving abnormally in the selected markets right now.'; host.appendChild(d); return; }\n    const bySym = d3.group(sparks, (p) => p.symbol);\n    rows.forEach((r) => {\n      const w = 'symbol=' + enc(r.symbol);\n      const mark = (el, f) => { el.setAttribute('data-source', 'movers'); el.setAttribute('data-field', f); el.setAttribute('data-where', w); return el; };\n      const card = document.createElement('article'); card.className = 'am-card'; card.id = 'card-' + r.symbol.replace(/[^A-Za-z0-9]/g, '-');\n      const top = document.createElement('div'); top.className = 'am-card-top';\n      const idw = document.createElement('div'); const s = document.createElement('div'); s.className = 'am-sym'; s.textContent = r.symbol; idw.appendChild(s);\n      const n = document.createElement('div'); n.className = 'am-name'; n.textContent = r.name || ''; idw.appendChild(n); top.appendChild(idw);\n      const chip = document.createElement('span'); chip.className = 'am-chip'; chip.textContent = r.market + (r.market_state === 'REGULAR' ? ' · open' : ''); top.appendChild(chip);\n      card.appendChild(top);\n      const big = document.createElement('div'); big.className = 'am-big-row';\n      const bv = mark(document.createElement('div'), 'day_pct'); bv.className = 'am-big ' + cls(r.day_pct); bv.textContent = fmt.pct(r.day_pct); big.appendChild(bv);\n      const z = mark(document.createElement('span'), 'z'); z.className = 'am-z'; z.textContent = fmt.z(r.z); big.appendChild(z);\n      card.appendChild(big);\n      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.setAttribute('class', 'am-spark'); svg.setAttribute('preserveAspectRatio', 'none'); card.appendChild(svg);\n      const st = document.createElement('div'); st.className = 'am-stats';\n      [['5 sessions', fmt.pct(r.wk_pct), 'wk_pct'], ['vs 200-DMA', fmt.pct(r.ma200_dev), 'ma200_dev'], ['Mkt cap', fmt.cap(r.mcap_usd), 'mcap_usd'], ['Net debt / EBITDA', fmt.ndE(r), 'nd_ebitda'], ['Price', fmt.price(r.price, r.currency), 'price'], ['Debt / EV', num(r.debt_ev) === null ? '—' : num(r.debt_ev).toFixed(0) + '%', 'debt_ev']]\n        .forEach(([k, v, f]) => { const d = document.createElement('div'); const a = document.createElement('span'); a.textContent = k; const b = mark(document.createElement('span'), f); b.textContent = v; d.appendChild(a); d.appendChild(b); st.appendChild(d); });\n      card.appendChild(st);\n      const cat = mark(document.createElement('div'), 'catalyst'); cat.className = 'am-cat'; cat.textContent = r.catalyst ? 'Next: ' + r.catalyst : 'No scheduled event on file'; card.appendChild(cat);\n      const note = mark(document.createElement('p'), 'note'); note.className = 'am-note'; note.textContent = r.note || (r.headlines && r.headlines[0] ? r.headlines[0].title : 'Note pending.'); card.appendChild(note);\n      host.appendChild(card);\n      requestAnimationFrame(() => sparkline(svg, (bySym.get(r.symbol) || []).map((p) => ({ date: p.date, close: num(p.close) })).filter((p) => p.close !== null)));\n    });\n  }\n\n  function marketsStrip(markets, movers, status) {\n    const host = $('#am-markets');\n    host.replaceChildren();\n    host.classList.toggle('dash-skeleton', status === 'loading');\n    if (status !== 'ok') return;\n    const order = ['S&P 500', 'NASDAQ', 'ASX', 'Nikkei 225', 'KOSPI'];\n    markets.slice().sort((a, b) => order.indexOf(a.market) - order.indexOf(b.market)).forEach((m) => {\n      const w = 'market=' + enc(m.market);\n      const mark = (el, f) => { el.setAttribute('data-source', 'markets'); el.setAttribute('data-field', f); el.setAttribute('data-where', w); return el; };\n      const d = document.createElement('div'); d.className = 'am-mkt';\n      const name = document.createElement('div'); name.className = 'am-mkt-name'; const nm = document.createElement('span'); nm.textContent = m.market; name.appendChild(nm);\n      const stt = mark(document.createElement('span'), 'state'); stt.className = 'am-state' + (m.state === 'REGULAR' ? ' is-open' : ''); stt.textContent = fmt.state(m.state); name.appendChild(stt); d.appendChild(name);\n      const flagged = movers.filter((r) => r.market === m.market && !r.peer && !r.excluded).length;\n      [['Last trade', fmt.whenShort(m.last_trade), 'last_trade'], ['Screened', String(num(m.quoted) ?? '—'), 'quoted'], ['Flagged', String(num(m.flagged) ?? flagged), 'flagged']]\n        .forEach(([k, v, f]) => { const row = document.createElement('div'); row.className = 'am-mkt-row'; const a = document.createElement('span'); a.textContent = k; const b = mark(document.createElement('span'), f); b.textContent = v; row.appendChild(a); row.appendChild(b); d.appendChild(row); });\n      if (m.source && String(m.source).startsWith('FAILED')) { const e = document.createElement('div'); e.className = 'am-mkt-row'; e.textContent = 'Universe failed this run'; e.style.color = 'var(--color-bad)'; d.appendChild(e); }\n      host.appendChild(d);\n    });\n  }\n\n  function draw() {\n    const mv = dash.data('movers'), mk = dash.data('markets'), sp = dash.data('sparks');\n    const market = dash.params().market || 'all';\n    if (marketSel !== document.activeElement) marketSel.value = market;\n    const all = (mv.status === 'ok' ? mv.data : []).map(norm);\n    const inMarket = (r) => market === 'all' || r.market === market;\n    const main = all.filter((r) => inMarket(r) && !r.peer && !r.excluded);\n    const t1 = main.filter((r) => r.tiers.includes(1));\n    const t2 = main.filter((r) => r.tiers.includes(2));\n    const t3 = main.filter((r) => r.tiers.includes(3));\n    const peers = all.filter((r) => r.peer && inMarket(r));\n    const excl = all.filter((r) => r.excluded && inMarket(r));\n    const sparks = sp.status === 'ok' ? sp.data : [];\n    cards(t1, sparks, mv.status === 'ok' && sp.status === 'loading' ? 'ok' : mv.status);\n    table('tier2', t2, mv.status); detail('tier2', t2);\n    table('tier3', t3, mv.status); detail('tier3', t3);\n    table('peers', peers, mv.status); detail('peers', peers);\n    $('#excluded').hidden = !state.showExcluded;\n    if (state.showExcluded) { table('excluded', excl, mv.status); detail('excluded', excl); }\n    $('#am-tier1-count').textContent = mv.status === 'ok' ? t1.length + (t1.length === 1 ? ' name' : ' names') : '';\n    $('#am-tier2-count').textContent = mv.status === 'ok' ? t2.length + (t2.length === 1 ? ' name' : ' names') : '';\n    $('#am-tier3-count').textContent = mv.status === 'ok' ? t3.length + (t3.length === 1 ? ' name' : ' names') : '';\n    $('#am-peers-count').textContent = mv.status === 'ok' ? peers.length + ' names' : '';\n    $('#am-excluded-count').textContent = mv.status === 'ok' ? excl.length + (excl.length === 1 ? ' name' : ' names') : '';\n    marketsStrip(mk.status === 'ok' ? mk.data : [], all, mk.status);\n    const c = dash.data('counts');\n    document.querySelectorAll('#am-takeaway [data-source=\"counts\"]').forEach((el) => {\n      el.classList.remove('dash-skeleton');\n      const f = el.getAttribute('data-field');\n      const v = c.status === 'ok' && c.data ? c.data[f] : null;\n      el.textContent = v === null || v === undefined ? '—' : (typeof v === 'number' ? v.toLocaleString('en') : String(v));\n    });\n  }\n  dash.onData(draw);\n  const named = document.getElementById(location.hash.slice(1));\n  if (named) setTimeout(() => { named.scrollIntoView(); dash.setLink(named.id); }, 300);\n})();\n</script>\n"}